FROM python:3.11-slim
# sqlalchemy<2.1: MLflow 2.22 imports FallbackAsyncAdaptedQueuePool, removed in SQLAlchemy 2.1
RUN pip install --no-cache-dir mlflow==2.22.0 "sqlalchemy>=2.0,<2.1"
EXPOSE 5000
CMD ["mlflow", "server", "--host", "0.0.0.0", "--port", "5000", \
     "--backend-store-uri", "sqlite:////mlflow/mlflow.db", \
     "--artifacts-destination", "/mlflow/artifacts", "--serve-artifacts"]
