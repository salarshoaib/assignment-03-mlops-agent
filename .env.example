# Copy to .env and fill in. NEVER commit .env.
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT=mlops-agent
AIRFLOW_BASE_URL=http://localhost:8080
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin
APPROVED_DAGS=training_pipeline
K8S_ALLOWED_NAMESPACES=mlops-agent
K8S_NAMESPACE=mlops-agent
K8S_DEPLOYMENT=ml-inference
K8S_LABEL_SELECTOR=app=ml-inference
DVC_DEFAULT_DATASET=data/raw/dataset.csv
# Leave empty to run the deterministic offline planner (no LLM calls)
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-4-6
# Quality thresholds + optional freshness policy (days). Retraining is only recommended with evidence.
MIN_F1=0.80
MIN_ACCURACY=0.80
MODEL_MAX_AGE_DAYS=
# Optional bearer token protecting the agent API
AGENT_API_TOKEN=
LOG_LEVEL=INFO
LOG_FILE=logs/agent.jsonl
